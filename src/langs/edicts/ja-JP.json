{
    "edicts": [
        {
            "id": "019f7551-e333-7498-b805-b5e04a8a1725",
            "source": "authored",
            "type": "culture",
            "title": "名勝スタンプ巡り",
            "presenter": "SiKongYu",
            "objector": "XieXuan",
            "demand": "臣、神都の名勝に石刻の印章を設け、民に巡遊して印を集める楽しみを与え、大宣の盛世を示すことを請います。",
            "messages": [
                {
                    "id": 0,
                    "sender": "presenter",
                    "content": "陛下、名勝に石刻の印章を設け、民にスタンプ巡りを奨励いたしましょう！"
                },
                {
                    "id": 1,
                    "sender": "presenter",
                    "content": "印を集めて巡遊すれば大周の山河をくまなく見て回れ、見聞も広がり、ついでに酒肆へ客も呼び込めます！"
                },
                {
                    "id": 2,
                    "sender": "objector",
                    "content": "……天下の名勝は八百か所、場所選び、調査、刻印……すべて工部の仕事ですか？"
                },
                {
                    "id": 3,
                    "sender": "objector",
                    "content": "臣の手元の治水図面もまだ描き終えておりません……"
                },
                {
                    "id": 4,
                    "sender": "presenter",
                    "content": "印がなければ、龍門へ行ったと誰が信じましょう？"
                },
                {
                    "id": 5,
                    "sender": "presenter",
                    "content": "印章があればこそ、民も家を出る気になるのです！"
                },
                {
                    "id": 6,
                    "sender": "objector",
                    "content": "印を刻むのは簡単ですが……臣の研究計画は止めねばなりません……"
                },
                {
                    "id": 7,
                    "sender": "presenter",
                    "content": "民が遠くまで出かけ、見聞を広めてこそ、大宣の素晴らしさを知るのです！"
                },
                {
                    "id": 8,
                    "sender": "objector",
                    "content": "印を押すことばかりで景色を楽しまず、これでは駅卒が道を急ぐのと何が違いましょう……"
                },
                {
                    "id": 9,
                    "sender": "objector",
                    "content": "臣の新発明はあと一歩で完成なのです、どうかこれ以上工部に仕事を増やさないでください……"
                },
                {
                    "id": 10,
                    "sender": "objector",
                    "content": "陛下、どうかご明察を！"
                }
            ],
            "status": "pending",
            "shouldDeepThought": false,
            "outcomes": {
                "approved": {
                    "title": "准奏！印章巡遊",
                    "content": "石刻の印章が神都の各所に置かれ、民は競って巡り歩き印を集める。やがて茶楼や酒肆にも記念印が設けられ、商人は便乗して値をつり上げ、一碗の茶が一壺の酒より高くなる。旅人は景色も茶の味も顧みず印を求めて急ぎ、名勝は行列の場と化し、花見は市へ出る苦行となる。",
                    "feedback": {
                        "speaker": "presenter",
                        "content": "陛下のご英断により、大宣の景勝は天下に名を轟かせましょう！"
                    },
                    "emperorComment": "伍宣皇帝、制して曰く:\n\t朕は天命を受け、天下万民を統べる。\n天下の名勝に石刻の印章を設け、民が巡遊して印を集め、雄大な大宣の山河を留めるよすがとせよ。印もなく、誰が龍門を訪れたと信じようか。印集めの巡遊は各地の宿や酒肆を潤し、見聞を広め、民間を活気づける。工部は直ちに場所を選び、印を刻め。"
                }
            }
        },
        {
            "id": "019f7551-e333-7498-b805-b93f333c9f50",
            "source": "authored",
            "type": "technology",
            "title": "黄道遊儀",
            "presenter": "XieXuan",
            "objector": "ChenWanEr",
            "demand": "臣、渾儀を改良し、黄道の度数によって星辰を精密に測ることを望みます。どうか多額の資金をお認めください。",
            "messages": [
                {
                    "id": 0,
                    "sender": "presenter",
                    "content": "陛下、臣が渾儀を改良すればこそ、天時の変化を知り、暦法の誤りを正せます。"
                },
                {
                    "id": 1,
                    "sender": "objector",
                    "content": "あなたの匠心にはいつも感服しておりますが、この渾儀はいったいいくらかかるのです？"
                },
                {
                    "id": 2,
                    "sender": "presenter",
                    "content": "……まだ計算中です……"
                },
                {
                    "id": 3,
                    "sender": "objector",
                    "content": "おやまあ、予算も出ていないのに先に奏上したのですか？少し気が早すぎますよ。"
                },
                {
                    "id": 4,
                    "sender": "presenter",
                    "content": "旧い儀器はもはや十分に役立ちません。正さなければ農時を誤り、民が凶作に見舞われかねません！"
                },
                {
                    "id": 5,
                    "sender": "objector",
                    "content": "星の運行は玄妙の極みです。大金を使って測り間違えたら、臣はどう申し開きをすればよいのです？"
                },
                {
                    "id": 6,
                    "sender": "presenter",
                    "content": "試してみなければ、できないとどうして分かりましょう……この技術は万民の役に立つと臣は考えます……"
                },
                {
                    "id": 7,
                    "sender": "objector",
                    "content": "万民のためになるなら臣も大賛成です。予算を上げていただければ、戸部でゆっくり審査いたしましょう。"
                },
                {
                    "id": 8,
                    "sender": "objector",
                    "content": "陛下、どうかご明察を！"
                }
            ],
            "status": "pending",
            "shouldDeepThought": false,
            "outcomes": {
                "rejected": {
                    "title": "驳回！正道を曲げぬ",
                    "content": "観測はいまだ旧い儀器に頼り、役人の目に映る星空は相変わらず古びたままだ。天文学研究の貴重な機会を逃したものの、司天監は旧例を踏襲し、長きにわたる安定を保った。",
                    "feedback": {
                        "speaker": "objector",
                        "content": "陛下のご明察にございます。天道の威儀は、古い法と制度に従うべきです。"
                    }
                }
            }
        }
    ]
}
